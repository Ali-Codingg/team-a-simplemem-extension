# Jev extension environment configuration
# Copy this file to extension/jev/.env and provide your own credentials.
# Never commit extension/jev/.env or share real API keys.

# Required: TypeSafe API key for the Jev retrieval-scoring controller.
TYPESAFE_API_KEY=

# Required: API key for the answer-generating LLM (separate from Jev).
ANSWER_LLM_API_KEY=

# Optional: answer-generating model override.
# The Jev controller model is configured in jev_controller.py (default: jev-1.13.0).
ANSWER_LLM_MODEL=gpt-4.1-mini

# Optional: OpenAI-compatible endpoint. Leave blank to use the baseline default.
ANSWER_LLM_BASE_URL=

